model User {
  id           String       @id @default(uuid())
  name         String
  email        String       @unique
  passwordHash String
  role         UserRole     @default(STUDENT)


  submissions  Submission[]
  feedback     Feedback[]   @relation("FeedbackAuthor")

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([role])
}